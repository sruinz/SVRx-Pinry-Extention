{
  "name": "SVRx Pinry",
  "version": "0.1.0",
  "description": "SVRx Pinry 서버에 현재 페이지의 이미지를 Pin으로 저장합니다.",
  "manifest_version": 3,
  "minimum_chrome_version": "121",
  "icons": {
    "16": "ico-16.png",
    "32": "ico-32.png",
    "48": "ico-48.png",
    "128": "ico-128.png"
  },
  "permissions": [
    "activeTab",
    "alarms",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "overlay.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "use_dynamic_url": true
    }
  ],
  "action": {
    "default_icon": {
      "16": "ico-16.png",
      "24": "ico-24.png",
      "32": "ico-32.png",
      "48": "ico-48.png"
    },
    "default_title": "SVRx Pinry"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
